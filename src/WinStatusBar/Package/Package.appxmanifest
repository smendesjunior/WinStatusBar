<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto MSIX do WinStatusBar (versão Microsoft Store). Usado só no build empacotado
  (tools\build-msix.ps1). Identity Name/Publisher e PublisherDisplayName são substituídos
  pelos valores reservados no Partner Center (parâmetros do script de build).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop rescap">

  <Identity Name="JuniorMendes.WinStatusBar" Publisher="CN=9FBF1CB5-AD0B-451F-B174-C8D6B7F4A349" Version="1.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>WinStatusBar</DisplayName>
    <PublisherDisplayName>Junior Mendes</PublisherDisplayName>
    <Logo>Package\Assets\StoreLogo.png</Logo>
    <Description>ms-resource:AppDescription</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
    <Resource Language="es" />
    <Resource Language="ja-JP" />
    <Resource Language="zh-Hans" />
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="WinStatusBar" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="WinStatusBar"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Package\Assets\Square150x150Logo.png"
        Square44x44Logo="Package\Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Package\Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Inicialização com o Windows: o usuário controla pelo app ou por Configurações › Aplicativos › Inicialização -->
        <desktop:Extension Category="windows.startupTask" Executable="WinStatusBar.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="WinStatusBarStartup" Enabled="false" DisplayName="WinStatusBar" />
        </desktop:Extension>
        <!-- Alias do coletor auxiliar: pertence ao aplicativo visível, sem app oculto separado. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="WinStatusBar.Collector.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="WinStatusBar.Collector.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>

  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
