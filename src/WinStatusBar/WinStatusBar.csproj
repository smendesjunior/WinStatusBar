<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinStatusBar</RootNamespace>
    <AssemblyName>WinStatusBar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinStatusBar.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DefaultLanguage>pt-BR</DefaultLanguage>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinStatusBar.Core\WinStatusBar.Core.csproj" />
    <Content Include="..\..\tools\accounts\*.ps1;..\..\tools\accounts\*.cmd" Link="AccountTools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\copilot\*.ps1;..\..\tools\copilot\*.cmd" Link="CopilotTools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\WinStatusBar.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WinStatusBar.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Logotipos vetoriais do agente: ChatGPT (parado/girando) e estrela animada do Claude trabalhando -->
    <Content Include="Assets\AgentLogos\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Battery\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\FluentIcons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Histórico mostrado em Configurações › Atualizações -->
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Área de transferência e emojis (antigo Windows Clipmanager) -->
    <Content Include="Assets\Clipboard.ico;Assets\Clipboard.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Clip\dados\emoji-test.txt;Clip\dados\annotations-*.json;Clip\dados\UNICODE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(NetworkUpdateBuild)' != ''">
    <AssemblyMetadata Include="NetworkUpdateBuild" Value="$(NetworkUpdateBuild)" />
  </ItemGroup>
  <!-- Build empacotado (MSIX / Microsoft Store): tools\build-msix.ps1 passa -p:WindowsPackageType=MSIX
       e -p:WsbCollectorDir=<publish do coletor>. A instalação tradicional (Setup.exe) não usa nada disto. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'MSIX'">
    <None Remove="Package\**" />
    <Content Remove="Package\**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="$(WsbAppxManifest)" Condition="'$(WsbAppxManifest)' != ''" />
    <AppxManifest Include="Package\Package.appxmanifest" Condition="'$(WsbAppxManifest)' == ''" />
    <Content Include="Package\Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(WsbCollectorDir)\WinStatusBar.Collector.exe;$(WsbCollectorDir)\WinStatusBar.Collector.dll;$(WsbCollectorDir)\WinStatusBar.Collector.deps.json;$(WsbCollectorDir)\WinStatusBar.Collector.runtimeconfig.json"
             Condition="'$(WsbCollectorDir)' != ''" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

