<UserControl x:Class="WinStatusBar.Views.Panels.InstalledAppsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Spacing="8" MinWidth="0">
  <TextBox x:Name="Search" PlaceholderText="Pesquisar aplicativos" TextChanged="SearchChanged" />
  <Grid ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
   <Button x:Name="RefreshButton" Grid.Column="1" Content="Atualizar" Click="RefreshClick" FontSize="12"/>
  </Grid>
  <ListView x:Name="AppsList" MaxHeight="310" SelectionMode="None" HorizontalContentAlignment="Stretch">
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
   <ListView.ItemTemplate><DataTemplate>
    <Grid MinHeight="48" ColumnSpacing="8" Padding="2,4" Margin="0,0,18,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid><FontIcon Glyph="&#xE71D;" FontSize="18"/><Image Source="{Binding Icon}" Width="24" Height="24"/></Grid>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button Grid.Column="2" Content="Desinstalar" IsEnabled="{Binding CanUninstall}" Tag="{Binding}" Click="UninstallClick" FontSize="12" Padding="8,5"/>
    </Grid>
   </DataTemplate></ListView.ItemTemplate>
  </ListView>
  <StackPanel x:Name="Confirmation" Visibility="Collapsed" Spacing="6">
   <TextBlock x:Name="ConfirmationText" FontSize="12" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Content="Desinstalar" Click="ConfirmClick"/>
    <Button Content="Cancelar" Click="CancelClick"/>
   </StackPanel>
  </StackPanel>
  <TextBlock x:Name="Feedback" FontSize="12" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
